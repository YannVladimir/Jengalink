{
  "name": "@jengalink/ui",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.mjs",
      "require": "./dist/web/index.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "import": "./dist/native/index.mjs",
      "require": "./dist/native/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/format.test.ts src/charts.test.ts"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "lucide-react-native": "^1.53.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3"
  },
  "dependencies": {
    "lucide-react": "^1.53.0",
    "@jengalink/i18n": "workspace:*"
  },
  "peerDependencies": {
    "lucide-react-native": "*",
    "react": ">=19",
    "react-native": "*",
    "react-native-svg": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "lucide-react-native": {
      "optional": true
    }
  }
}
