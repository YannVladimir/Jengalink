{
  "name": "@jengalink/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "pnpm db:migrate:test && jest --config ./test/jest-e2e.json --runInBand",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "ts-node src/db/migrate.ts .env",
    "db:migrate:test": "ts-node src/db/migrate.ts .env.test",
    "db:check": "drizzle-kit check && node scripts/check-migrations.mjs",
    "openapi": "ts-node src/openapi/generate.ts",
    "openapi:check": "ts-node src/openapi/generate.ts --check",
    "db:seed": "ts-node src/db/seed.ts .env",
    "demo:reset": "ts-node src/demo/demo-reset.ts .env.demo",
    "demo:start": "node --env-file=.env.demo dist/main",
    "backup": "ts-node src/ops/backup-cli.ts backup .env",
    "backup:list": "ts-node src/ops/backup-cli.ts list .env",
    "backup:restore": "ts-node src/ops/backup-cli.ts restore .env",
    "backup:drill": "ts-node src/ops/backup-cli.ts drill .env"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@jengalink/contracts": "workspace:*",
    "@jengalink/i18n": "workspace:*",
    "@jengalink/ui": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@sentry/node": "^11.6.0",
    "drizzle-orm": "^0.45.3",
    "exifr": "^7.1.3",
    "libphonenumber-js": "^1.13.15",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "pg-boss": "^11.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "dotenv": "^18.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
