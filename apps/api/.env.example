# Copy to .env (development) or .env.test (tests). Staging and production
# get these from the host's secret store, never from a file.
APP_ENV=development
PORT=3000
DATABASE_URL=postgres://jengalink:jengalink@localhost:5433/jengalink_dev
JOBS_ENABLED=true
S3_ENDPOINT=http://localhost:8333
# For a phone on the same Wi-Fi, set this to http://<your-PC-LAN-IP>:8333
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=jengalink-dev
S3_ACCESS_KEY_ID=jengalink
S3_SECRET_ACCESS_KEY=jengalink-local-secret
S3_FORCE_PATH_STYLE=true
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
OTP_PEPPER=
SMS_PROVIDER=console
EMAIL_PROVIDER=console
WEB_APP_URL=http://localhost:5173
LOG_LEVEL=info
# pretty (default in development) or json (default in staging/production)
LOG_FORMAT=
# Sentry error tracking; empty = off
SENTRY_DSN=

# Rate limits on sign-in checks, uploads and share links (must stay on in staging/production).
RATE_LIMITS=on
# Behind a load balancer: hops to trust for the client address (usually 1 when hosted).
TRUST_PROXY=0
# Browser origins allowed to call the API; empty = WEB_APP_URL (+ local previews in development).
CORS_ORIGINS=

# Virus scanning of uploaded photos. Empty = basic EICAR-only check (not allowed in production).
# Start ClamAV with `pnpm scan:up`, then set CLAMAV_HOST=localhost.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Backups (pnpm backup). Local: pg_dump runs inside the Postgres container.
PG_DOCKER_CONTAINER=jengalink-postgres
# Where backups go (default: .backups at the repo root) and the encryption key (openssl rand -hex 32).
BACKUP_DIR=
BACKUP_KEY=
